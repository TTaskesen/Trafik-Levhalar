--
-- For more information on build.settings, see the Project Build Settings guide at:
-- https://docs.coronalabs.com/guide/distribution/buildSettings
--

settings =
{
	orientation =
	{
		-- Supported values for orientation:
		-- portrait, portraitUpsideDown, landscapeLeft, landscapeRight
		default = "portrait",
		supported = { "portrait", },
	},

	android =
	{
		-- Release AAB ağ izni istemez. Supabase ve kullanıcı hikâyesi yazma
		-- kaynakları yalnız debug için tutulur ve aşağıda paketten çıkarılır.
		-- Google Play'deki targetSdk değeri, kullanılan Solar2D sürümüyle
		-- oluşturulan AAB'nin manifestinden ayrıca doğrulanmalıdır.
		versionCode = "8",
		versionName = "1.0.2",
		-- Google Play kapalı test yükleyicisi API 21 ve üzerini gerektirir.
		minSdkVersion = "21",
	},

	-- Solar2D'nin varsayılan açılış logosu yerine uygulama simgesini gösterir.
	-- Görsel, Android paketi oluşturulurken başlangıç ekranı için kullanılır.
	splashScreen =
	{
		android =
		{
			enable = true,
			image = "splash-icon.png",
		},
	},

	--
	-- iOS section
	--
	iphone =
	{
		xcassets = "Images.xcassets",
		plist =
		{
			-- App Store için gösterilen sürüm ve her yüklemede artacak derleme numarası.
			CFBundleShortVersionString = "1.0.2",
			-- Öğrenme ilerlemesi ve sınav geçmişi değişikliği için Build 13.
			CFBundleVersion = "13",
			-- App Store Connect iOS 15 ve üzerini gerektiriyor.
			MinimumOSVersion = "15.0",
			-- Solar2D 3731'in otomatik yer tutucularını gerçek uygulama davranışıyla
			-- uyumlu açıklamalarla değiştirir. Uygulama bu kaynaklara erişmez.
			NSAppleMusicUsageDescription = "Trafik Levhaları Apple Music arşivinize erişmez.",
			NSBluetoothPeripheralUsageDescription = "Trafik Levhaları Bluetooth kullanmaz.",
			NSCalendarsUsageDescription = "Trafik Levhaları takviminize erişmez.",
			NSCameraUsageDescription = "Trafik Levhaları kameranızı kullanmaz.",
			NSContactsUsageDescription = "Trafik Levhaları kişilerinize erişmez.",
			NSHomeKitUsageDescription = "Trafik Levhaları HomeKit kullanmaz.",
			NSLocationAlwaysUsageDescription = "Trafik Levhaları konumunuzu kullanmaz.",
			NSLocationUsageDescription = "Trafik Levhaları konumunuzu kullanmaz.",
			NSLocationWhenInUseUsageDescription = "Trafik Levhaları konumunuzu kullanmaz.",
			NSMicrophoneUsageDescription = "Trafik Levhaları mikrofonu kullanmaz.",
			NSMotionUsageDescription = "Trafik Levhaları hareket verilerini kullanmaz.",
			NSPhotoLibraryUsageDescription = "Trafik Levhaları fotoğraf arşivinizi okumaz.",
			NSPhotoLibraryAddUsageDescription = "Trafik Levhaları fotoğraf arşivinize erişmez.",
			NSRemindersUsageDescription = "Trafik Levhaları anımsatıcılarınıza erişmez.",
			NSSiriUsageDescription = "Trafik Levhaları Siri ile bütünleşmez.",
			NSSpeechRecognitionUsageDescription = "Trafik Levhaları konuşma tanımayı kullanmaz.",
			UIStatusBarHidden = true,
			UILaunchStoryboardName = "LaunchScreen",
		},
	},

	--
	-- Plugins section
	--
	plugins =
	{

	},

	--
	-- Project section
	--
	excludeFiles =
	{
		-- Exclude unnecessary files for each platform
		-- Git geçmişi uygulama kaynağı değildir; iOS imzalama adımını da bozabilir.
		all = { "Icon.png", "Icon-*dpi.png", "Images.xcassets", ".git/*", },
		iphone = {
			-- Android ve geliştirme kaynakları iOS yayın paketine dahil edilmez.
			"AndroidResources/*",
			-- Statik hikâye seçimi ve okuyucu iOS yayın akışında kullanılabilir.
			-- Yalnızca kullanıcı hikâyesi/UGC yardımcıları paket dışı bırakılır.
			"sahne13.lua", "sahne14.lua",
			"hikaye_cache.lua", "hikaye_guvenlik.lua", "hikaye_kayit.lua",
			"supabase_hikayeler.lua", "supabase_config.lua", "supabase_config.example.lua", "ugc_*.lua",
			"uygulama_ayar.local.lua", "uygulama_ayar.local.example.lua",
			"e-book/*", "supabase/*.sql",
			"docs/*", "store-assets/*", "privacy-policy.html", "GOOGLE_PLAY_RELEASE.md", "PLAY_CONSOLE_LISTING.md", "IOS_RELEASE_CHECKLIST.md",
		},
		android = {
			"LaunchScreen.storyboardc",
			-- Kullanıcı hikâyesi yazma/Supabase yalnız debug akışıdır.
			"sahne13.lua", "sahne14.lua", "hikaye_*.lua",
			"supabase_hikayeler.lua", "supabase_config.lua", "supabase_config.example.lua", "ugc_*.lua",
			"uygulama_ayar.local.lua", "uygulama_ayar.local.example.lua",
			-- Aynı çalışma ağacındaki bağımsız e-kitap projesi release AAB'ye girmez.
			"e-book/*",
			-- Supabase migration betiği yalnız geliştirici içindir, uygulamaya girmez.
			"supabase/*.sql",
			-- Yayın belgeleri ve GitHub Pages kaynağı AAB'ye dahil edilmez.
			"docs/*", "store-assets/*", "privacy-policy.html", "GOOGLE_PLAY_RELEASE.md", "PLAY_CONSOLE_LISTING.md", "IOS_RELEASE_CHECKLIST.md",
		},
	},
}
